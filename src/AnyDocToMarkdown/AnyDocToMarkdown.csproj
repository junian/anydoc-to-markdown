<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>AnyDocToMarkdown</AssemblyName>
    <RootNamespace>AnyDocToMarkdown</RootNamespace>

    <Version>0.1.0</Version>
    <Description>Convert documents (doc, docx, odt, rtf, epub, pdf, presentations, spreadsheets, csv) to GitHub-Flavored Markdown, backed by the anydoc Rust engine shipped as a native library for Windows (x86/x64/arm64), macOS (x64/arm64), and Linux (x64/arm64).</Description>
    <PackageId>AnyDocToMarkdown</PackageId>
    <Authors>Junian Triajianto</Authors>
    <Owners>junian</Owners>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/junian/anydoc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/junian/anydoc</RepositoryUrl>
    <PackageTags>markdown; docx; pptx; xlsx; epub; pdf; converter; document</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    NativeMethods.g.cs (csbindgen-emitted DllImport surface) is compiled via
    the default *.cs globs; regenerate it with `cargo build -p anydoc-dotnet`.
  -->

  <!--
    Native binaries laid out per NuGet's runtimes/{rid}/native convention and
    packed for every RID; when the package is consumed, the SDK copies only the
    assets matching the target's RuntimeIdentifier (iOS/Android/desktop
    resolvers bundle exactly their architecture). Nothing is copied on a plain
    project reference; host tests copy the osx-arm64 library explicitly.
  -->
  <ItemGroup>
    <None Include="runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/" />
  </ItemGroup>

  <!-- Shared types used by both the native and WebAssembly bindings live in
       AnyDocToMarkdown.Shared/ so neither package owns a duplicate copy. -->
  <ItemGroup>
    <Compile Include="../AnyDocToMarkdown.Shared/Model.cs" Link="Shared/Model.cs" />
    <Compile Include="../AnyDocToMarkdown.Shared/Types.cs" Link="Shared/Types.cs" />
  </ItemGroup>

  <!-- System.Text.Json: the netstandard2.0 surface has no reflection-free JSON;
       the package provides it for every consuming runtime. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>